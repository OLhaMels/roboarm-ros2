<?xml version="1.0"?>
<robot name="roboarm">
  <group name="arm"><chain base_link="base_link" tip_link="tool0"/></group>
  <group name="gripper"><joint name="gripper_joint"/></group>
  <end_effector name="gripper" parent_link="tool0" group="gripper" parent_group="arm"/>
  <group_state name="ready" group="arm"><joint name="z_joint" value="0.05"/><joint name="rotation_joint" value="0"/></group_state>
  <disable_collisions link1="base_link" link2="carriage" reason="Adjacent"/>
  <disable_collisions link1="carriage" link2="arm_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="arm_link" reason="Designed overlap at column mounting"/>
  <disable_collisions link1="arm_link" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="finger" reason="Adjacent"/>
  <disable_collisions link1="arm_link" link2="finger" reason="Gripper mounting overlap"/>
</robot>
